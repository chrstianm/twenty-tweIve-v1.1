; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GAMEDEV_FINALS"
run/main_scene="uid://dq41qniuixbdv"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://dcoiis6w8k6rt"

[autoload]

CursorManager="*res://CursorManager.gd"
AudioManager="*res://Assets/Audio/AudioManager.tscn"
GlobalManager="*res://global_manager.tscn"
Inventory="*res://InventoryManager.gd"
InventoryUi="*res://inventory_ui.tscn"
SceneChanger="*res://Scenes/ExtraScenes/scene_changer.tscn"
SuspenseTimer="*res://Scenes/ExtraScenes/suspense_timer.tscn"

[display]

window/size/mode=3
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[input]

exit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
